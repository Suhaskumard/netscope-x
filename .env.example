# NETSCOPE-X environment configuration example.
#
# Copy this file to `.env` (already gitignored, never committed) and fill
# in real values for local development. All variables are prefixed
# NETSCOPE_ to avoid colliding with unrelated environment variables that
# might already be set on the host.

NETSCOPE_ENVIRONMENT=development
NETSCOPE_LOG_LEVEL=INFO
NETSCOPE_API_HOST=0.0.0.0
NETSCOPE_API_PORT=8000

# Never commit a real secret here. This placeholder is intentionally
# insecure and the application refuses to start with
# NETSCOPE_ENVIRONMENT=production while this value is unchanged -- see
# backend/app/core/config.py.
NETSCOPE_SECRET_KEY=dev-insecure-placeholder-change-me
